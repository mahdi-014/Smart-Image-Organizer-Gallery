# Environment Configuration Template
# Copy this file to .env and configure your values.
# NEVER commit your actual .env file or API keys to version control.

# Application Settings
APP_ENV=development
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Maximum Allowed Image Pixels (~89.48 Megapixels)
# Safety ceiling protecting against decompression bomb attacks
# MAX_IMAGE_PIXELS=89478485

# Storage Paths
# DATA_DIR defaults to ./data relative to project root
DATA_DIR=data

# Optional Path Overrides
# By default, thumbnails and database are placed inside DATA_DIR:
#   THUMBNAILS_DIR defaults to $DATA_DIR/thumbnails
#   DATABASE_PATH defaults to $DATA_DIR/gallery.db
# Uncomment and set these only if you require separate storage locations:
# THUMBNAILS_DIR=data/thumbnails
# DATABASE_PATH=data/gallery.db

# Cloud AI Settings (Optional - Disabled by default)
ENABLE_GEMINI_API=False
GEMINI_API_KEY=
