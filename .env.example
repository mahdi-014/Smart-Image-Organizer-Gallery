# Environment Configuration Template
# Copy this file to .env and configure your values.
# NEVER commit your actual .env file or API keys to version control.

# Application Settings
APP_ENV=development
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Storage Paths (defaults to ./data relative to project root)
DATA_DIR=data
THUMBNAILS_DIR=data/thumbnails
DATABASE_PATH=data/gallery.db

# Cloud AI Settings (Optional - Disabled by default)
ENABLE_GEMINI_API=False
GEMINI_API_KEY=

